# Copie ce fichier en .env et remplis-le. Ne commite jamais .env.

# --- Riot ---
# Clé API Riot : https://developer.riotgames.com (la clé de développement expire toutes les 24 h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Serveur de jeu (routage « plateforme ») : euw1, eun1, na1, kr...
RIOT_PLATFORM=euw1

# --- Données ---
# Base de données. SQLite par défaut ; pour MySQL / MariaDB (pip install "lolcoach[mysql]") :
# DATABASE_URL=mysql+pymysql://utilisateur:motdepasse@localhost/lolcoach
DATABASE_URL=sqlite:///donnees/lolcoach.db
# Archive des réponses brutes de Riot (permet de tout recalculer plus tard). Vide = désactivée.
LOLCOACH_ARCHIVE_DIR=donnees/brut
# Dossier des modèles entraînés (fichiers JSON).
LOLCOACH_MODELS_DIR=modeles

# --- « Le mot du coach », écrit par un modèle de langage (facultatif) ---
# aucun (défaut, gratuit : texte de base), ollama (local, gratuit) ou claude (API payante)
LOLCOACH_LLM=aucun
# Modèle. Ollama : gemma3:4b par défaut (ollama pull gemma3:4b). Claude : claude-opus-5-5
# par défaut ; claude-haiku-5-5 coûte beaucoup moins cher et suffit pour quelques phrases.
# LOLCOACH_LLM_MODEL=
# OLLAMA_HOST=http://127.0.0.1:11434
# Clé de l'API Claude, lue par le SDK officiel (seulement si LOLCOACH_LLM=claude) :
# ANTHROPIC_API_KEY=

# --- API web (lolcoach-api) ---
# Par défaut : écoute sur ce PC seulement, jeton généré dans donnees/api-token.
# LOLCOACH_API_HOST=127.0.0.1
# LOLCOACH_API_PORT=8765
# LOLCOACH_API_TOKEN=
# Plafond d'appels au modèle de langage par heure (protège contre une facture imprévue).
# LOLCOACH_LLM_MAX_PER_HOUR=20

# --- Coach IA (voir docs/COACH_IA.md) ---
# Ton Riot ID : joueur par défaut du coach automatique et du serveur MCP.
# LOLCOACH_RIOT_ID=TonPseudo#EUW
# Ou directement ton identifiant (affiché par lolcoach-collecte joueur) :
# LOLCOACH_PUUID=
# Dossier des fiches de connaissances.
# LOLCOACH_KNOWLEDGE_DIR=connaissances
# Dossier d'installation de League of Legends, s'il n'est pas à l'emplacement habituel
# (C:\Riot Games\League of Legends ou /Applications/League of Legends.app/Contents/LoL).
# LOLCOACH_LOL_DIR=
# IA qui regarde les captures du replay : aucun, gemini, agy, claude-code, commande
# LOLCOACH_VISION=aucun
# IA qui rédige le rapport : aucun, gemini, agy, claude-code, claude, commande
# LOLCOACH_REDACTEUR=aucun
# Modèles (gemini-4-argon par défaut pour Gemini) :
# LOLCOACH_VISION_MODEL=
# LOLCOACH_REDACTEUR_MODEL=
# Commandes personnalisées (jetons : {prompt} {prompt_file} {schema_file} {images} {dossier}) :
# LOLCOACH_VISION_CMD=agy -p {prompt} --output-format json --json-schema {schema_file}
# LOLCOACH_REDACTEUR_CMD=
# Fiches tirées de vidéos YouTube : gemini (défaut), agy ou commande (LOLCOACH_FICHES_CMD)
# LOLCOACH_FICHES=gemini
# 1 = les fiches créées par une IA sont validées d'office, sans relecture (défaut : à valider)
# LOLCOACH_FICHES_AUTO_VALIDER=1
# Clé de l'API Gemini (seulement pour les choix « gemini ») :
# GEMINI_API_KEY=
